# Copy to .env and adjust.
NODE_ENV=development
PORT=5000

# Database (matches docker-compose.yml)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=creh

# REQUIRED. The server refuses to start without it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=15m

# Comma-separated browser origins allowed by CORS
CORS_ORIGIN=http://localhost:5173

# Mounts dev-only helpers such as POST /api/resources/seed (defaults to false when NODE_ENV=production)
ENABLE_DEV_ROUTES=true

LOG_LEVEL=info

# ---- Phase 1: identity ----
# Access tokens are short-lived (see JWT_EXPIRES_IN); the client silently refreshes using a rotating refresh token.
REFRESH_TOKEN_TTL_DAYS=30
VERIFICATION_CODE_TTL_MIN=15

# Email: "console" prints verification codes in the API log (dev). "resend" sends real mail.
EMAIL_PROVIDER=console
EMAIL_FROM=CREH <onboarding@resend.dev>
RESEND_API_KEY=

# Server-side geocoding for home location (address search / reverse lookup). Optional:
# without it, users set their home location by dropping a pin on the map.
MAPBOX_ACCESS_TOKEN=

# Set to false to disable auth rate limiting (e.g. while running repeated manual checks).
RATE_LIMIT_ENABLED=true

# ---- Phase 2: resource images ----
# Set all three to use Cloudinary signed direct uploads; leave empty to store images on local disk (dev).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
